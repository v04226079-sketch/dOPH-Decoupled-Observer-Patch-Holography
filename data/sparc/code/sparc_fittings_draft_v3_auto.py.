import numpy as np
import pandas as pd
import requests
import zipfile
from pathlib import Path
from tqdm import tqdm
import warnings
warnings.filterwarnings("ignore")

# ====================== dOPH КОНСТАНТЫ И МОДЕЛЬ ======================
try:
    # Пытаемся импортировать главную улучшенную модель из репо
    from doph_model_improved import doph_velocity_model, P_THEORY
    print(f"dOPH: Успешно загружена improved модель с P = {P_THEORY:.5f}")
except ImportError:
    print("Предупреждение: doph_model_improved.py не найден рядом.")
    P_THEORY = np.sqrt(8.0 / 3.0)
    def doph_velocity_model(R, params, galaxy_data=None):
        # Временная заглушка, пока модель не подключилась
        return np.sqrt(galaxy_data['Vdisk']**2 * params[0] + galaxy_data.get('Vgas', 0)**2) if galaxy_data is not None else np.zeros_like(R) + 150

# ====================== АВТОМАТИЧЕСКАЯ ЗАГРУЗКА + РАСПАКОВКА SPARC ======================
def load_sparc_auto(data_dir: str = "data/sparc"):
    data_dir = Path(data_dir)
    data_dir.mkdir(parents=True, exist_ok=True)
    
    zip_path = data_dir / "Rotmod_LTG.zip"
    extract_dir = data_dir / "Rotmod_LTG"
    
    # 1. Скачиваем зип автоматически, если его нет
    if not zip_path.exists():
        url = "http://astroweb.case.edu/SPARC/Rotmod_LTG.zip"
        print("Автоматически скачиваем Rotmod_LTG.zip со всеми ~175 галактиками SPARC...")
        try:
            r = requests.get(url, stream=True, timeout=120)
            r.raise_for_status()
            total = int(r.headers.get('content-length', 0))
            
            with open(zip_path, 'wb') as f, tqdm(desc="Скачивание", total=total, unit='iB', unit_scale=True) as bar:
                for chunk in r.iter_content(chunk_size=8192):
                    size = f.write(chunk)
                    bar.update(size)
            print("Скачивание завершено.")
        except Exception as e:
            print(f"Ошибка скачивания: {e}")
            print("Попробуй скачать вручную с http://astroweb.case.edu/SPARC/ и положить в data/sparc/Rotmod_LTG.zip")
            return []
    
    # 2. Распаковываем, если нужно
    if not extract_dir.exists() or len(list(extract_dir.glob("*.dat"))) < 100:
        print("Распаковываем архив...")
        with zipfile.ZipFile(zip_path, 'r') as z:
            z.extractall(extract_dir)
        print(f"Распаковано {len(list(extract_dir.glob('*.dat')))} файлов .dat")
    
    # 3. Загружаем все галактики
    galaxies = []
    for file in extract_dir.glob("*.dat"):
        gal_name = file.stem.upper()
        try:
            df = pd.read_csv(file, delim_whitespace=True, comment='#', header=None)
            if len(df.columns) >= 6:
                df.columns = ['R', 'Vobs', 'Verr', 'Vgas', 'Vdisk', 'Vbul'] + list(df.columns[6:])
            df = df[(df['R'] > 0) & (df['Vobs'] > 0)].copy()
            if len(df) >= 8:   # минимум точек для фита
                galaxies.append((gal_name, df))
        except:
            pass
    
    print(f"Загружено галактик SPARC: {len(galaxies)}")
    return galaxies

# ====================== ФИТИНГ (простой) ======================
def fit_single_galaxy(gal_name, df):
    R = df['R'].values
    Vobs = df['Vobs'].values
    Verr = df.get('Verr', pd.Series(np.ones_like(Vobs)*5)).values
    
    def wrapper(R, *params):
        return doph_velocity_model(R, params, galaxy_data=df)
    
    try:
        from scipy.optimize import curve_fit
        popt, _ = curve_fit(wrapper, R, Vobs, p0=[0.5], sigma=Verr, bounds=(0, 10))
        chi2_red = np.sum(((Vobs - wrapper(R, *popt)) / Verr)**2) / (len(R) - len(popt))
        print(f"✓ {gal_name}  χ²_red = {chi2_red:.3f}")
        return {'galaxy': gal_name, 'red_chi2': chi2_red, 'params': popt, 'P': P_THEORY}
    except Exception as e:
        print(f"✗ {gal_name} ошибка: {str(e)[:80]}")
        return None

# ====================== MAIN ======================
if __name__ == "__main__":
    print("=== dOPH SPARC FITTINGS — ЧЕРНОВИК v3 (автозагрузка) ===\n")
    
    galaxies = load_sparc_auto()
    
    if not galaxies:
        print("Не удалось загрузить данные. Проверь интернет или скачай зип вручную.")
    else:
        results = []
        # Для начала тестируем на первых 20 галактиках (чтобы не висело долго)
        for gal_name, df in galaxies[:20]:
            res = fit_single_galaxy(gal_name, df)
            if res:
                results.append(res)
        
        if results:
            df_res = pd.DataFrame(results)
            Path("results").mkdir(exist_ok=True)
            df_res.to_csv("results/sparc_doph_auto_draft_v3.csv", index=False)
            print("\nСредний reduced χ² по первым 20 галактикам:", df_res['red_chi2'].mean())
            print("Результаты сохранены в results/sparc_doph_auto_draft_v3.csv")
